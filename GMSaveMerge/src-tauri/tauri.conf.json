{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "GMSaveMerge",
    "version": "1.0.0",
    "identifier": "com.gmsave.merge",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:3011",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "GameMaker 8.0 - 合并外部更改",
                "width": 1280,
                "height": 840,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "center": true,
                "visible": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
